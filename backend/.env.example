# Existing API settings
PORT=8000
FIREBASE_PROJECT_ID="ecoloop-staging-20261015"
GOOGLE_CLOUD_PROJECT_NUMBER=
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Set GEMINI_API_KEY (preferred) or GOOGLE_API_KEY for Gemini Developer API;
# GEMINI_API_KEY wins if both are set. Or select vertex and explicitly set
# AGENT_VERTEX_PROJECT_ID and AGENT_VERTEX_LOCATION for Vertex AI with
# Application Default Credentials. Managed Sessions and Memory Bank also
# require AGENT_VERTEX_ENGINE_LOCATION and AGENT_VERTEX_ENGINE_ID; the
# Agent Engine location is independent of the Gemini model location.
# With auto, a Developer API key wins; otherwise explicit Vertex project and
# location select Vertex. No complete provider configuration means unavailable.
AGENT_ENABLED=false
AGENT_PROVIDER=auto
GEMINI_API_KEY=
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_VERTEX_PROJECT_ID=
AGENT_VERTEX_LOCATION=
AGENT_VERTEX_ENGINE_LOCATION=
AGENT_SESSION_STORE=in_memory
AGENT_VERTEX_ENGINE_ID=
AGENT_SESSION_IDLE_TTL_SECONDS=86400
AGENT_MEMORY_BANK_ENABLED=false
AGENT_REQUEST_TIMEOUT_SECONDS=20
AGENT_MAX_OUTPUT_TOKENS=4096
AI_DAILY_REQUEST_LIMIT=12

# Demo-only surplus recovery pilot. Keep disabled until both independently
# deployed Agent Runtime resources and the NGO allowlist are configured.
# Agent Runtime resource names may use the numeric project identifier above.
SURPLUS_PILOT_ENABLED=false
SURPLUS_INTAKE_AGENT_RESOURCE=
COLLECTION_PLANNER_AGENT_RESOURCE=
AGENT_RUNTIME_LOCATION=asia-south1
SURPLUS_AGENT_TIMEOUT_SECONDS=25
MAX_SURPLUS_MEDIA_BYTES=5000000
