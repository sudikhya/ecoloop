# Public Firebase Web App config values. These are client identifiers, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecoloop-staging-20261015.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecoloop-staging-20261015
NEXT_PUBLIC_FIREBASE_APP_ID=1:26177403871:web:8b3125a80812c8c28be26a

# Public browser key restricted to approved EcoLoop HTTPS origins and to the
# Maps JavaScript API plus Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Canonical FastAPI origin. Use an HTTPS origin outside local development.
NEXT_PUBLIC_ECOLOOP_API_ORIGIN=

# Keep false until live identity/database acceptance is complete and enabling is approved.
# This public build flag controls browser commands only; API permissions remain mandatory.
NEXT_PUBLIC_ECOLOOP_ENABLE_COMMANDS=false
# Household creation is a separate capability and stays disabled outside the local demo launcher.
NEXT_PUBLIC_ECOLOOP_ENABLE_HOUSEHOLD_CREATE=false

# Enables the isolated demo-only household surplus and NGO portal UI. The API
# still requires the matching server flag, role records, and deployed agents.
NEXT_PUBLIC_ECOLOOP_ENABLE_SURPLUS_PILOT=false
